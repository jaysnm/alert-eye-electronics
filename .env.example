# ---------------------------------------------------------------------------
# Alert Eye Electronics — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Core
DATABASE_URI=postgres://alerteye:alerteye_dev@localhost:5433/alerteye
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media storage — Cloudflare R2 (S3-compatible). Leave blank in local dev to use disk.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
NEXT_PUBLIC_S3_PUBLIC_URL=

# Email — Resend
RESEND_API_KEY=
EMAIL_FROM="Alert Eye Electronics <orders@alerteye.co.ke>"
EMAIL_STAFF_INBOX=sales@alerteye.co.ke

# Payments — Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Payments — Safaricom Daraja (M-Pesa STK Push)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/webhooks/mpesa

# Manual payment details shown to customers at checkout
NEXT_PUBLIC_MPESA_PAYBILL=
NEXT_PUBLIC_BANK_DETAILS="Alert Eye Electronics Ltd — Equity Bank — A/C 000000000"
