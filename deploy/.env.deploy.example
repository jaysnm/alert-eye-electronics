# ---------------------------------------------------------------------------
# Alert Eye Electronics — deployment environment
#
#   cp deploy/.env.deploy.example deploy/.env   and fill in.
#   deploy/.env is git-ignored. Never commit it.
#
# Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Host / TLS ---
# Domain that points (A / AAAA record) at this VM's public IP.
DOMAIN=alerteye.co.ke
NEXT_PUBLIC_SERVER_URL=https://alerteye.co.ke
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@alerteye.co.ke

# --- Database (PostgreSQL, in-stack) ---
POSTGRES_USER=alerteye
POSTGRES_DB=alerteye
POSTGRES_PASSWORD=CHANGE_ME_long_random

# --- Payload ---
PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- Object storage (MinIO, in-stack) ---
MINIO_ROOT_USER=alerteye
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random
S3_BUCKET=alerteye-media
# Leave blank: media is served through the app (/api/media/...). Only set this
# if you expose MinIO on its own public subdomain (see deploy/README.md).
NEXT_PUBLIC_S3_PUBLIC_URL=

# --- Email (Resend) — optional; emails print to logs if unset ---
# Quote any value that contains spaces or < >.
RESEND_API_KEY=
EMAIL_FROM="Alert Eye Electronics <orders@alerteye.co.ke>"
EMAIL_STAFF_INBOX=sales@alerteye.co.ke

# --- Payments: Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Payments: Safaricom Daraja (M-Pesa STK Push) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://alerteye.co.ke/api/webhooks/mpesa
# Optional comma-separated allow-list for Safaricom's callback source IPs.
MPESA_ALLOWED_IPS=

# --- Checkout display copy (shown to customers) ---
NEXT_PUBLIC_MPESA_PAYBILL=
NEXT_PUBLIC_BANK_DETAILS="Alert Eye Electronics Ltd — Equity Bank — A/C 000000000"

# --- Backups (deploy/scripts/backup.sh) ---
# How many daily backups to keep locally under deploy/backups/.
BACKUP_RETENTION_DAYS=14
